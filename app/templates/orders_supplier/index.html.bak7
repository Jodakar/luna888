{% extends 'base.html' %}
{% block title %}Заказы поставщику{% endblock %}
{% block content %}
<div class="container mt-3" style="max-width: 1200px;">
    <!-- Список заказов -->
    <div id="ordersCard">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4>🛒 Заказы поставщику</h4>
            <div>
                <button class="btn btn-outline-secondary btn-sm" onclick="toggleSuppliers()">📋 Поставщики</button>
                <button class="btn btn-outline-danger btn-sm" onclick="resetOrderFilters()">✖️ Сбросить</button>
                <button class="btn btn-primary btn-sm" onclick="createNewOrder()">➕ Новый заказ</button>
            </div>
        </div>
        
        <div class="mb-2">
                <input type="text" id="globalSearch" class="form-control form-control-sm" placeholder="🔍 Поиск по номеру, поставщику, статусу, дате...">
            </div>
            <div class="table-responsive">
            <table class="table table-sm table-hover">
                <thead>
                    <tr class="table-light">
                        <th><input type="text" class="form-control form-control-sm filter-input" data-col="order_number" placeholder="Фильтр номер"></th>
                        <th><input type="text" class="form-control form-control-sm filter-input" data-col="supplier_name" placeholder="Фильтр поставщик"></th>
                        <th><input type="text" class="form-control form-control-sm filter-input" data-col="status" placeholder="Фильтр статус"></th>
                        <th><input type="text" class="form-control form-control-sm filter-input" data-col="created_at" placeholder="Фильтр дата"></th>
                        <th></th>
                    </tr>
                </thead>
                <thead>
                    <tr class="table-secondary">
                        <th onclick="sortOrders('order_number')" style="cursor:pointer;">⇅</th>
                        <th onclick="sortOrders('supplier_name')" style="cursor:pointer;">⇅</th>
                        <th onclick="sortOrders('status')" style="cursor:pointer;">⇅</th>
                        <th onclick="sortOrders('created_at')" style="cursor:pointer;">⇅</th>
                        <th></th>
                    </tr>
                </thead>
                <thead class="table-dark">
                    <tr>
                        <th>Номер</th>
                        <th>Поставщик</th>
                        <th>Статус</th>
                        <th>Дата</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody id="ordersBody">
                    <tr><td colspan="5" class="text-center text-muted">Загрузка...</td></tr>
                </tbody>
            </table>
        </div>
    </div>
    
    <!-- Поставщики -->
    <div id="suppliersCard" style="display:none;" class="mb-3">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Поставщики</span>
                <button class="btn btn-outline-primary btn-sm" onclick="openSupplierModal()">➕ Добавить</button>
            </div>
            <div class="card-body p-2">
                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Название</th>
                                <th>ИНН</th>
                                <th>Телефон</th>
                                <th>Email</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="suppliersBody">
                            <tr><td colspan="5" class="text-center text-muted">Загрузка...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Новый заказ / Просмотр -->
    <div id="orderCard" style="display:none;">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span id="orderTitle">Новый заказ</span>
                <span id="orderNumber" class="badge bg-primary"></span>
            </div>
            <div class="card-body p-2">
                <div class="row mb-2">
                    <div class="col-md-3">
                        <label class="form-label small">Поставщик *</label>
                        <select class="form-select form-select-sm" id="supplierSelect">
                            <option value="">Выберите...</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Мин. остаток</label>
                        <input type="number" class="form-control form-control-sm" id="minStock" value="3">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Дней поставки</label>
                        <input type="number" class="form-control form-control-sm" id="deliveryDays" value="7">
                        <div class="field-hint small">Заказали сегодня, привезли послезавтра = 2</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Период продаж</label>
                        <select class="form-select form-select-sm" id="salesPeriod" onchange="togglePeriod()">
                            <option value="7">Неделя</option>
                            <option value="30" selected>Месяц</option>
                            <option value="365">Год</option>
                            <option value="custom">Свой</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">&nbsp;</label>
                        <button class="btn btn-outline-secondary btn-sm w-100" onclick="exportOrderExcel()">📊 Excel</button>
                    </div>
                </div>
                <div class="row mb-2" id="customPeriodRow" style="display:none;">
                    <div class="col-md-3">
                        <label class="form-label small">С даты</label>
                        <input type="date" class="form-control form-control-sm" id="periodFrom">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">По дату</label>
                        <input type="date" class="form-control form-control-sm" id="periodTo">
                    </div>
                </div>
                
                <div class="mb-2 d-flex align-items-center gap-2">
                    <input type="text" id="globalSearchItems" class="form-control form-control-sm" placeholder="🔍 Поиск по артикулу, размеру...">
                    <button class="btn btn-outline-danger btn-sm" onclick="resetOrderFilters()">✖️ Сбросить</button>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr class="table-light">
                                <th><input type="text" class="form-control form-control-sm filter-input" data-col="article" placeholder="Фильтр"></th>
                                <th><input type="text" class="form-control form-control-sm filter-input" data-col="size" placeholder="Фильтр"></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th><input type="text" class="form-control form-control-sm filter-input" data-col="buy_price" placeholder="Фильтр"></th>
                                <th><input type="text" class="form-control form-control-sm filter-input" data-col="recommended" placeholder="Фильтр"></th>
                            </tr>
                        </thead>
                        <thead>
                            <tr class="table-secondary">
                                <th onclick="sortItems('article')" style="cursor:pointer;">⇅</th>
                                <th onclick="sortItems('size')" style="cursor:pointer;">⇅</th>
                                <th onclick="sortItems('stock')" style="cursor:pointer;">⇅</th>
                                <th onclick="sortItems('days')" style="cursor:pointer;">⇅</th>
                                <th onclick="sortItems('sales')" style="cursor:pointer;">⇅</th>
                                <th onclick="sortItems('buy_price')" style="cursor:pointer;">⇅</th>
                                <th onclick="sortItems('recommended')" style="cursor:pointer;">⇅</th>
                            </tr>
                        </thead>
                        <thead class="table-dark">
                            <tr>
                                <th>Артикул</th>
                                <th>Размер</th>
                                <th>Остаток</th>
                                <th>Дней на складе</th>
                                <th>Продажи</th>
                                <th>Закупка</th>
                                <th>Рекомендуемое</th>
                            </tr>
                        </thead>
                        <tbody id="orderBody">
                            <tr><td colspan="7" class="text-center text-muted">Загрузка...</td></tr>
                        </tbody>
                    </table>
                </div>
                
                <div class="mt-2" id="orderButtons">
                    <button class="btn btn-success btn-sm" onclick="saveOrder()">💾 Сохранить</button>
                    <button class="btn btn-primary btn-sm" id="sendBtn" onclick="sendOrder()">📤 Отправить</button>
                    <button class="btn btn-secondary btn-sm" onclick="cancelOrder()">Отмена</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно уведомлений -->
<div class="modal fade" id="alertModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="alertTitle">Уведомление</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="alertBody">
                Сообщение
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно подтверждения -->
<div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmTitle">Подтверждение</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="confirmBody">
                Вы уверены?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-danger" id="confirmOk">Да</button>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно поставщика -->
<div class="modal fade" id="supplierModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Добавить поставщика</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label small">Краткое наименование *</label>
                    <input type="text" class="form-control form-control-sm" id="supName" required>
                </div>
                <div class="mb-2">
                    <label class="form-label small">ИНН</label>
                    <input type="text" class="form-control form-control-sm" id="supInn">
                </div>
                <div class="mb-2">
                    <label class="form-label small">Телефон</label>
                    <input type="text" class="form-control form-control-sm" id="supPhone">
                </div>
                <div class="mb-2">
                    <label class="form-label small">Email</label>
                    <input type="email" class="form-control form-control-sm" id="supEmail">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="addSupplier()">Сохранить</button>
            </div>
        </div>
    </div>
</div>

<script>
let suppliers = [];

// Кастомные уведомления
function showAlert(message, title = 'Уведомление') {
    document.getElementById('alertTitle').textContent = title;
    document.getElementById('alertBody').textContent = message;
    new bootstrap.Modal(document.getElementById('alertModal')).show();
}

function showConfirm(message, onConfirm, title = 'Подтверждение') {
    document.getElementById('confirmTitle').textContent = title;
    document.getElementById('confirmBody').textContent = message;
    
    const confirmBtn = document.getElementById('confirmOk');
    confirmBtn.onclick = function() {
        bootstrap.Modal.getInstance(document.getElementById('confirmModal')).hide();
        onConfirm();
    };
    
    new bootstrap.Modal(document.getElementById('confirmModal')).show();
}
let products = [];
let daysOnShelfMap = {};
let orders = [];
let filteredOrders = [];
let currentOrderId = null;
let currentOrderStatus = null;
let sortOrderCol = null;
let sortOrderDir = 1;
let sortItemCol = null;
let sortItemDir = 1;

// Загрузка заказов
function loadOrders() {
    const orderId = {{ order_id|default(0) }};
    fetch('/orders-supplier/api/orders', {credentials: 'same-origin'})
        .then(res => res.json())
        .then(data => {
            orders = data.orders || [];
            filteredOrders = [...orders];
            renderOrders();
        });
}

function renderOrders() {
    // Переприменяем фильтры после рендера
    const searchText = document.getElementById('globalSearch')?.value || '';
    if (searchText) applyOrderFilters();
    const tbody = document.getElementById('ordersBody');
    if (filteredOrders.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Нет заказов</td></tr>';
        return;
    }
    
    tbody.innerHTML = filteredOrders.map(o => {
        let statusBadge;
        if (o.status === 'confirmed') {
            statusBadge = '<span class="badge bg-success">✅ Подтверждён</span>';
        } else if (o.is_sent) {
            statusBadge = '<span class="badge bg-info">📤 Отправлено</span>';
        } else {
            statusBadge = '<span class="badge bg-warning">🟡 Ожидает</span>';
        }
        
        const delivery = o.delivery_date ? '<br><small>Поставка: ' + new Date(o.delivery_date).toLocaleDateString('ru-RU') + '</small>' : '';
        
        return '<tr style="cursor:pointer;" onclick="openOrder(' + o.id + ')">'
            + '<td>' + o.order_number + '</td>'
            + '<td>' + (o.supplier_name || '—') + '</td>'
            + '<td>' + statusBadge + delivery + '</td>'
            + '<td>' + formatDateTime(o.updated_at || o.created_at) + '</td>'
            + '<td><button class="btn btn-sm btn-outline-danger" onclick="event.stopPropagation(); deleteOrder(' + o.id + ', \'' + o.order_number + '\')">🗑️</button></td>'
            + '</tr>';
    }).join('');
}

function formatDateTime(isoDate) {
    if (!isoDate) return '—';
    const d = new Date(isoDate);
    const dd = String(d.getDate()).padStart(2, '0');
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const yyyy = d.getFullYear();
    return dd + '.' + mm + '.' + yyyy + ' ' + String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
}

function openOrder(id) {
    window.location.href = '/orders-supplier/order/' + id;
}

function createNewOrder() {
    currentOrderId = null;
    window.location.href = '/orders-supplier/new';
}

function loadProductsForOrder() {
    // Загружаем товары
    fetch('/products/api/data', {credentials: 'same-origin'})
        .then(res => res.json())
        .then(data => {
            products = data.products || [];
            
            // Загружаем дни на складе
            return fetch('/orders-supplier/api/days-on-shelf', {credentials: 'same-origin'});
        })
        .then(res => res.json())
        .then(data => {
            daysOnShelfMap = data.days_map || {};
            renderOrderTable();
        });
}

function renderOrderTable() {
    const tbody = document.getElementById('orderBody');
    const minStockEl = document.getElementById('minStock');
    const minStock = minStockEl ? (parseInt(minStockEl.value) || 0) : 0;
    
    if (products.length === 0) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted">Нет данных</td></tr>';
        return;
    }
    
    tbody.innerHTML = products.map(p => {
        const totalStock = p.total_stock || 0;
        const buyPrice = p.buy_price ? (p.buy_price / 100).toFixed(2) : '—';
        const recommended = totalStock < minStock ? (minStock - totalStock) : 0;
        
        return '<tr>'
            + '<td class="col-article">' + p.article + '</td>'
            + '<td class="col-size">' + p.size + '</td>'
            + '<td class="col-stock">' + totalStock + '</td>'
            + '<td class="col-days">' + getDaysOnShelf(p.variant_id) + '</td>'
            + '<td class="col-sales">—</td>'
            + '<td class="col-buy_price">' + buyPrice + '</td>'
            + '<td class="col-recommended"><input type="number" class="form-control form-control-sm" value="' + recommended + '" min="0"></td>'
            + '</tr>';
    }).join('');
}

function resetOrderFilters() {
    // Очищаем глобальный поиск
    const globalSearch = document.getElementById('globalSearch');
    if (globalSearch) globalSearch.value = '';
    
    // Очищаем фильтры
    document.querySelectorAll('#ordersCard .filter-input').forEach(input => input.value = '');
    
    // Очищаем поиск в карточке
    const itemSearch = document.getElementById('globalSearchItems');
    if (itemSearch) itemSearch.value = '';
    
    // Очищаем фильтры карточки
    document.querySelectorAll('#orderCard .filter-input').forEach(input => input.value = '');
    
    // Переприменяем
    if (typeof applyOrderFilters === 'function') applyOrderFilters();
    if (typeof applyItemFilters === 'function') applyItemFilters();
    
    // Сбрасываем сортировку
    sortOrderCol = null;
    sortItemCol = null;
    
    // Показываем все строки
    document.querySelectorAll('#orderBody tr').forEach(row => {
        row.style.display = '';
    });
}

function toggleSuppliers() {
    const card = document.getElementById('suppliersCard');
    card.style.display = card.style.display === 'none' ? '' : 'none';
}

function togglePeriod() {
    const period = document.getElementById('salesPeriod').value;
    document.getElementById('customPeriodRow').style.display = period === 'custom' ? '' : 'none';
}

function loadSuppliers() {
    return fetch('/orders-supplier/api/suppliers', {credentials: 'same-origin'})
        .then(res => res.json())
        .then(data => {
            suppliers = data.suppliers || [];
            renderSuppliers();
            fillSupplierSelect();
        });
}

function renderSuppliers() {
    const tbody = document.getElementById('suppliersBody');
    if (suppliers.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Нет поставщиков</td></tr>';
        return;
    }
    
    tbody.innerHTML = suppliers.map(s => 
        '<tr>'
        + '<td>' + s.name + '</td>'
        + '<td>' + (s.inn || '—') + '</td>'
        + '<td>' + (s.phone || '—') + '</td>'
        + '<td>' + (s.email || '—') + '</td>'
        + '<td><button class="btn btn-sm btn-outline-danger" onclick="deleteSupplier(' + s.id + ')">🗑️</button></td>'
        + '</tr>'
    ).join('');
}

function fillSupplierSelect() {
    document.getElementById('supplierSelect').innerHTML = 
        '<option value="">Выберите...</option>' + 
        suppliers.map(s => '<option value="' + s.id + '">' + s.name + '</option>').join('');
}

function openSupplierModal() {
    document.getElementById('supName').value = '';
    document.getElementById('supInn').value = '';
    document.getElementById('supPhone').value = '';
    document.getElementById('supEmail').value = '';
    new bootstrap.Modal(document.getElementById('supplierModal')).show();
}

function addSupplier() {
    const data = {
        name: document.getElementById('supName').value,
        inn: document.getElementById('supInn').value,
        phone: document.getElementById('supPhone').value,
        email: document.getElementById('supEmail').value
    };
    
    fetch('/orders-supplier/api/supplier/add', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(data)
    })
    .then(res => res.json())
    .then(() => {
        bootstrap.Modal.getInstance(document.getElementById('supplierModal')).hide();
        loadSuppliers();
    });
}

function deleteSupplier(id) {
    showConfirm('Удалить поставщика?', function() { deleteSupplierConfirmed(id); }); return; } function deleteSupplierConfirmed(id) {
    fetch('/orders-supplier/api/supplier/' + id, {method: 'DELETE'})
        .then(() => loadSuppliers());
}

let isSaving = false;

function saveOrder() {
    // Строгая блокировка от повторных нажатий
    if (isSaving) {
        console.log('Уже сохраняется...');
        return;
    }
    isSaving = true;
    
    // Блокируем все кнопки сохранения
    const saveBtn = document.querySelector('button[onclick="saveOrder()"]');
    if (saveBtn) {
        saveBtn.disabled = true;
        saveBtn.innerHTML = '⏳ Сохранение...';
    }
    
    const supplierId = document.getElementById('supplierSelect').value;
    
    if (!supplierId) {
        showAlert('Выберите поставщика');
        isSaving = false;
        if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.innerHTML = '💾 Сохранить';
        }
        return;
    }
    
    if (!products || products.length === 0) {
        showAlert('Товары ещё не загрузились. Подождите...');
        isSaving = false;
        if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.innerHTML = '💾 Сохранить';
        }
        return;
    }
    
    const items = [];
    const rows = document.querySelectorAll('#orderBody tr');
    
    rows.forEach((row) => {
        const qtyInput = row.querySelector('input[type="number"]');
        if (!qtyInput) return;
        
        const qty = parseInt(qtyInput.value) || 0;
        if (qty <= 0) return;
        
        // Ищем товар по строке
        const articleCell = row.querySelector('.col-article');
        const sizeCell = row.querySelector('.col-size');
        
        if (articleCell && sizeCell) {
            const article = articleCell.textContent.trim();
            const size = sizeCell.textContent.trim();
            
            const product = products.find(p => p.article === article && p.size === size);
            if (product) {
                items.push({
                    product_id: product.id,
                    quantity: qty
                });
            }
        }
    });
    
    if (items.length === 0) {
        showAlert('Нет позиций для заказа (введите количество)');
        isSaving = false;
        if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.innerHTML = '💾 Сохранить';
        }
        return;
    }
    
    console.log('Отправка заказа:', {supplier_id: supplierId, items_count: items.length});
    
    const url = currentOrderId 
        ? '/orders-supplier/api/order/' + currentOrderId + '/update'
        : '/orders-supplier/api/order/create';
    
    const method = currentOrderId ? 'PUT' : 'POST';
    
    fetch(url, {
        method: method,
        credentials: 'same-origin',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
            supplier_id: supplierId,
            min_stock: parseInt(document.getElementById('minStock').value) || 3,
            delivery_days: parseInt(document.getElementById('deliveryDays').value) || 7,
            sales_period: document.getElementById('salesPeriod').value || '30',
            items: items
        })
    })
    .then(res => {
        if (!res.ok) {
            return res.json().then(data => { throw new Error(data.error || 'Ошибка сервера'); });
        }
        return res.json();
    })
    .then(data => {
        if (data.success) {
            currentOrderId = data.order.id;
            showAlert('Заказ ' + data.order.order_number + ' сохранён');
            window.location.href = '/orders-supplier';
        } else {
            showAlert('Ошибка: ' + (data.error || 'неизвестно'));
        }
    })
    .catch(err => {
        showAlert('Ошибка сохранения: ' + err.message);
        console.error('Error:', err);
        isSaving = false;
        if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.innerHTML = '💾 Сохранить';
        }
    });
}

function deleteOrder(id, number) {
    showConfirm('Удалить заказ ' + number + '?', function() {
        deleteOrderConfirmed(id);
    });
    return;
}

function deleteOrderConfirmed(id) {
    
    // Ищем кнопку и меняем текст
    const btn = event.target;
    if (btn && btn.tagName === 'BUTTON') {
        btn.disabled = true;
        btn.innerHTML = '⏳';
    }
    
    fetch('/orders-supplier/api/order/' + id + '/delete', {
        method: 'DELETE',
        credentials: 'same-origin'
    })
    .then(res => res.json())
    .then(data => {
        if (data.error) {
            alert(data.error);
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '🗑️';
            }
        } else {
            loadOrders();
        }
    })
    .catch(err => {
        showAlert('Ошибка: ' + err.message);
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '🗑️';
        }
    });
}

function getDaysOnShelf(variantId) {
    const firstDate = daysOnShelfMap[variantId];
    if (!firstDate) return '—';
    
    const today = new Date();
    const first = new Date(firstDate);
    const diffDays = Math.floor((today - first) / (1000 * 60 * 60 * 24));
    
    return diffDays;
}

function cancelOrder() {
    window.location.href = '/orders-supplier';
}

function sendOrder() {
    if (!currentOrderId) {
        showAlert('Сначала сохраните заказ');
        return;
    }
    
    showConfirm('Отправить заказ поставщику?', function() { sendOrderConfirmed(); }); return; } function sendOrderConfirmed() {
    window.location.href = '/orders-supplier/order/' + currentOrderId + '/send';
}

function importOrderExcel() {
    document.getElementById('importFile').click();
}

function handleImport(event) {
    const file = event.target.files[0];
    if (!file) return;
    
    const reader = new FileReader();
    
    reader.onload = function(e) {
        const text = e.target.result;
        const lines = text.split('\n').filter(line => line.trim());
        
        if (lines.length < 2) {
            showAlert('Файл пустой');
            return;
        }
        
        // Парсим заголовки
        const headers = lines[0].replace('\uFEFF', '').split(';').map(h => h.trim());
        
        // Находим индексы
        const articleIdx = headers.findIndex(h => h === 'Артикул');
        const sizeIdx = headers.findIndex(h => h === 'Размер');
        const qtyIdx = headers.findIndex(h => h === 'Рекомендуемое' || h === 'Заказано');
        
        if (articleIdx === -1 || qtyIdx === -1) {
            showAlert('Файл не содержит нужных колонок. Ожидается: Артикул, Размер, Заказать');
            return;
        }
        
        // Парсим данные
        const importedItems = [];
        
        for (let i = 1; i < lines.length; i++) {
            const cols = lines[i].split(';');
            const article = (cols[articleIdx] || '').trim();
            const size = sizeIdx !== -1 ? (cols[sizeIdx] || '').trim() : '';
            const qty = parseInt(cols[qtyIdx] || '0');
            
            if (article && qty > 0) {
                importedItems.push({article, size, qty});
            }
        }
        
        if (importedItems.length === 0) {
            showAlert('Нет позиций для импорта');
            return;
        }
        
        // Применяем к таблице
        let found = 0;
        let notFound = [];
        
        importedItems.forEach(item => {
            const rows = document.querySelectorAll('#orderBody tr');
            let matched = false;
            
            rows.forEach(row => {
                const articleCell = row.querySelector('.col-article');
                const sizeCell = row.querySelector('.col-size');
                
                if (articleCell && sizeCell) {
                    const rowArticle = articleCell.textContent.trim();
                    const rowSize = sizeCell.textContent.trim();
                    
                    if (rowArticle === item.article && rowSize === item.size) {
                        const qtyInput = row.querySelector('input[type="number"]');
                        if (qtyInput) {
                            qtyInput.value = item.qty;
                            matched = true;
                        }
                    }
                }
            });
            
            if (matched) found++;
            else notFound.push(item.article + '-' + item.size);
        });
        
        showAlert('Импортировано: ' + found + '\nНе найдено: ' + (notFound.length ? notFound.join(', ') : 'нет'));
    };
    
    reader.readAsText(file, 'UTF-8');
    event.target.value = '';
}

function exportOrderExcel() {
    // Собираем видимые строки
    const rows = document.querySelectorAll('#orderBody tr');
    const visibleRows = [];
    
    rows.forEach(row => {
        if (row.style.display !== 'none' && row.querySelector('.col-article')) {
            visibleRows.push(row);
        }
    });
    
    if (visibleRows.length === 0) {
        showAlert('Нет данных для экспорта');
        return;
    }
    
    // Заголовки
    const headers = ['Артикул', 'Размер', 'Остаток', 'Дней на складе', 'Продажи', 'Закупка', 'Рекомендуемое'];
    let csv = '\uFEFF' + headers.join(';') + '\n';
    
    visibleRows.forEach(row => {
        const article = row.querySelector('.col-article')?.textContent.trim() || '';
        const size = row.querySelector('.col-size')?.textContent.trim() || '';
        const stock = row.querySelector('.col-stock')?.textContent.trim() || '0';
        const days = row.querySelector('.col-days')?.textContent.trim() || '—';
        const sales = row.querySelector('.col-sales')?.textContent.trim() || '0';
        const buyPrice = row.querySelector('.col-buy_price')?.textContent.trim() || '';
        const qty = row.querySelector('input[type="number"]')?.value || '0';
        
        csv += [article, size, stock, days, sales, buyPrice, qty].join(';') + '\n';
    });
    
    const blob = new Blob([csv], {type: 'text/csv;charset=utf-8;'});
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'заказ_товары_' + new Date().toISOString().split('T')[0] + '.csv';
    link.click();
}

// Сортировка заказов
function sortOrders(col) {
    if (sortOrderCol === col) sortOrderDir *= -1;
    else { sortOrderCol = col; sortOrderDir = 1; }
    
    filteredOrders.sort((a, b) => {
        const val_a = String(a[col] || '').toLowerCase();
        const val_b = String(b[col] || '').toLowerCase();
        return val_a.localeCompare(val_b) * sortOrderDir;
    });
    
    renderOrders();
}

// Глобальный поиск
document.getElementById('globalSearch')?.addEventListener('input', applyOrderFilters);

// Сортировка позиций
function sortItems(col) {
    if (sortItemCol === col) sortItemDir *= -1;
    else { sortItemCol = col; sortItemDir = 1; }
    
    products.sort((a, b) => {
        const val_a = col === 'stock' ? (a.total_stock || 0) : 
                      col === 'buy_price' ? (a.buy_price || 0) : 
                      String(a[col] || '').toLowerCase();
        const val_b = col === 'stock' ? (b.total_stock || 0) : 
                      col === 'buy_price' ? (b.buy_price || 0) : 
                      String(b[col] || '').toLowerCase();
        
        if (typeof val_a === 'string') return val_a.localeCompare(val_b) * sortItemDir;
        return (val_a - val_b) * sortItemDir;
    });
    
    renderOrderTable();
}

// Обработчики для пересчёта (через делегирование)
document.addEventListener('change', function(e) {
    if (e.target.id === 'minStock' || e.target.id === 'deliveryDays') {
        recalculateRecommendations();
    }
});

document.addEventListener('input', function(e) {
    if (e.target.id === 'minStock' || e.target.id === 'deliveryDays') {
        recalculateRecommendations();
    }
});

// Переход по Enter между ячейками "Рекомендуемое"
document.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && e.target.type === 'number') {
        e.preventDefault();
        
        const currentRow = e.target.closest('tr');
        const nextRow = currentRow.nextElementSibling;
        
        if (nextRow) {
            const nextInput = nextRow.querySelector('input[type="number"]');
            if (nextInput) {
                nextInput.focus();
                nextInput.select();
            }
        }
    }
});

function recalculateRecommendations() {
    const spinner = document.getElementById('calcSpinner');
    if (spinner) spinner.style.display = '';
    
    // Мгновенный пересчёт
    const minStockEl = document.getElementById('minStock');
    const minStock = minStockEl ? (parseInt(minStockEl.value) || 0) : 0;
    const rows = document.querySelectorAll('#orderBody tr');
    
    rows.forEach((row, index) => {
        const stockCell = row.querySelector('.col-stock');
        const inputCell = row.querySelector('input[type="number"]');
        
        if (stockCell && inputCell && products[index]) {
            const totalStock = parseInt(stockCell.textContent) || 0;
            const recommended = totalStock < minStock ? (minStock - totalStock) : 0;
            inputCell.value = recommended;
        }
    });
    
    if (spinner) spinner.style.display = 'none';
}

// Фильтры для позиций заказа
// Глобальный поиск в карточке
document.getElementById('globalSearchItems')?.addEventListener('input', function() {
    applyItemFilters();
});

function applyItemFilters() {
    const filters = {};
    document.querySelectorAll('#orderCard .filter-input').forEach(input => {
        filters[input.dataset.col] = input.value.toLowerCase().trim();
    });
    
    const searchText = document.getElementById('globalSearchItems')?.value.toLowerCase().trim() || '';
    const rows = document.querySelectorAll('#orderBody tr');
    
    rows.forEach(row => {
        let show = true;
        
        // Глобальный поиск
        if (searchText) {
            const article = row.querySelector('.col-article')?.textContent.toLowerCase() || '';
            const size = row.querySelector('.col-size')?.textContent.toLowerCase() || '';
            
            if (!article.includes(searchText) && !size.includes(searchText)) {
                row.style.display = 'none';
                return;
            }
        }
        
        for (const [col, value] of Object.entries(filters)) {
            if (!value) continue;
            
            // Для колонки "Заказать" — ищем в input
            if (col === 'recommended') {
                const input = row.querySelector('input[type="number"]');
                if (input) {
                    const inputValue = input.value.trim();
                    if (!inputValue.includes(value)) {
                        show = false;
                        break;
                    }
                } else {
                    show = false;
                    break;
                }
                continue;
            }
            
            const cell = row.querySelector('.col-' + col);
            if (cell) {
                const cellValue = cell.textContent.toLowerCase();
                if (!cellValue.includes(value)) {
                    show = false;
                    break;
                }
            }
        }
        
        row.style.display = show ? '' : 'none';
    });
}

// Обработчики фильтров позиций
document.querySelectorAll('#orderCard .filter-input').forEach(input => {
    input.addEventListener('input', applyItemFilters);
});

// Обработчики фильтров заказов
document.querySelectorAll('#ordersCard .filter-input').forEach(input => {
    input.addEventListener('input', applyOrderFilters);
});

function applyOrderFilters() {
    const filters = {};
    document.querySelectorAll('#ordersCard .filter-input').forEach(input => {
        filters[input.dataset.col] = input.value.toLowerCase().trim();
    });
    
    const searchText = document.getElementById('globalSearch')?.value.toLowerCase().trim() || '';
    
    filteredOrders = orders.filter(o => {
        // Глобальный поиск
        if (searchText) {
            const statusText = o.status === 'confirmed' ? 'подтверждён' : 'ожидает';
            const searchFields = [
                o.order_number || '',
                o.supplier_name || '',
                statusText,
                formatDateTime(o.updated_at || o.created_at)
            ];
            
            if (!searchFields.some(f => f.toLowerCase().includes(searchText))) return false;
        }
        
        // Фильтры
        for (const [col, value] of Object.entries(filters)) {
            if (!value) continue;
            
            let fieldValue = '';
            if (col === 'status') {
                fieldValue = o.status === 'confirmed' ? 'подтверждён' : 'ожидает';
            } else if (col === 'created_at') {
                fieldValue = formatDateTime(o.updated_at || o.created_at);
            } else {
                fieldValue = String(o[col] || '').toLowerCase();
            }
            
            if (!fieldValue.includes(value)) return false;
        }
        return true;
    });
    
    renderOrders();
}

// Исправляем сортировку дней и заказать
function sortItems(col) {
    if (sortItemCol === col) sortItemDir *= -1;
    else { sortItemCol = col; sortItemDir = 1; }
    
    products.sort((a, b) => {
        let val_a, val_b;
        
        switch(col) {
            case 'stock':
                val_a = a.total_stock || 0;
                val_b = b.total_stock || 0;
                break;
            case 'buy_price':
                val_a = a.buy_price || 0;
                val_b = b.buy_price || 0;
                break;
            case 'days':
                val_a = parseInt(getDaysOnShelf(a.variant_id)) || 999;
                val_b = parseInt(getDaysOnShelf(b.variant_id)) || 999;
                break;
            case 'recommended':
                const minStockEl = document.getElementById('minStock');
    const minStock = minStockEl ? (parseInt(minStockEl.value) || 0) : 0;
                val_a = (a.total_stock || 0) < minStock ? minStock - (a.total_stock || 0) : 0;
                val_b = (b.total_stock || 0) < minStock ? minStock - (b.total_stock || 0) : 0;
                break;
            default:
                val_a = String(a[col] || '').toLowerCase();
                val_b = String(b[col] || '').toLowerCase();
        }
        
        if (typeof val_a === 'string') return val_a.localeCompare(val_b) * sortItemDir;
        return (val_a - val_b) * sortItemDir;
    });
    
    renderOrderTable();
}

document.addEventListener('DOMContentLoaded', function() {
    const mode = '{{ mode|default("") }}';
    const orderId = {{ order_id|default(0) }};
    
    if (mode === 'new') {
        document.getElementById('ordersCard').style.display = 'none';
        document.getElementById('suppliersCard').style.display = 'none';
        document.getElementById('orderCard').style.display = '';
        
        document.getElementById('orderTitle').textContent = 'Новый заказ';
        
        // Получаем следующий номер
        fetch('/orders-supplier/api/next-number', {credentials: 'same-origin'})
            .then(res => res.json())
            .then(data => {
                document.getElementById('orderNumber').textContent = 'Номер: ' + data.next_number;
            });
        document.getElementById('orderButtons').style.display = '';
        
        // Загружаем настройки из последнего заказа
        fetch('/orders-supplier/api/last-settings', {credentials: 'same-origin'})
            .then(res => res.json())
            .then(settings => {
                document.getElementById('minStock').value = settings.min_stock || 3;
                document.getElementById('deliveryDays').value = settings.delivery_days || 7;
                document.getElementById('salesPeriod').value = settings.period || '30';
                
                // Загружаем поставщиков и товары
                loadSuppliers();
                loadProductsForOrder();
            });
    } else if (mode === 'view') {
        // Показываем карточку
        document.getElementById('ordersCard').style.display = 'none';
        document.getElementById('suppliersCard').style.display = 'none';
        document.getElementById('orderCard').style.display = '';
        currentOrderId = orderId;
        
        // Последовательно загружаем всё
        loadSuppliers()
            .then(() => fetch('/orders-supplier/api/order/' + orderId + '/data', {credentials: 'same-origin'}))
            .then(r => r.json())
            .then(data => {
                const order = data.order;
                document.getElementById('orderTitle').textContent = 'Заказ ' + order.order_number;
                document.getElementById('orderNumber').textContent = order.order_number;
                currentOrderStatus = order.status;
                document.getElementById('supplierSelect').value = data.supplier_id || '';
                document.getElementById('minStock').value = data.min_stock || 3;
                document.getElementById('deliveryDays').value = data.delivery_days || 7;
                document.getElementById('salesPeriod').value = data.sales_period || '30';
                
                if (order.status === 'confirmed') {
                    document.getElementById('orderButtons').style.display = 'none';
                    document.getElementById('supplierSelect').disabled = true;
                }
                
                return fetch('/products/api/data', {credentials: 'same-origin'});
            })
            .then(r => r.json())
            .then(data => {
                products = data.products || [];
                renderOrderTable();
                return fetch('/orders-supplier/api/days-on-shelf', {credentials: 'same-origin'});
            })
            .then(r => r.json())
            .then(data => {
                daysOnShelfMap = data.days_map || {};
                renderOrderTable();
            })
            .catch(err => {
                console.error('Ошибка загрузки:', err);
                document.getElementById('orderBody').innerHTML = '<tr><td colspan="7" class="text-center text-danger">Ошибка загрузки данных</td></tr>';
            });
    }
    // Для main-страницы (не new/view)
    if (!mode) {
        loadOrders();
        loadSuppliers();
    }
});
</script>
{% endblock %}
